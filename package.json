{
  "name": "ross_visualizer",
  "version": "0.1.0",
  "description": "Music visualizer that listens to your audio and paints with the colors of the album art.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Rossmel Abasto",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
