pkgname=ross-visualizer-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Music visualizer that listens to your computer and paints with the album art'
arch=('x86_64')
url='https://github.com/rossmelabasto/ross_visualizer'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'gtk-layer-shell' 'libayatana-appindicator' 'pipewire-audio' 'playerctl' 'curl')
provides=('ross-visualizer')
conflicts=('ross-visualizer')
options=('!strip' '!debug')
source=("ross-visualizer-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/ross-visualizer-$pkgver-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "ross-visualizer-$pkgver-x86_64"
  install -Dm755 ross-visualizer "$pkgdir/usr/bin/ross-visualizer"
  install -Dm644 ross-visualizer.desktop "$pkgdir/usr/share/applications/ross-visualizer.desktop"
  install -Dm644 ross-visualizer.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ross-visualizer.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
